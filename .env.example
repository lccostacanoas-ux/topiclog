# =============================================================================
# TOPIC LOG — Variáveis de Ambiente de Exemplo (Ambiente de Testes / Sandbox)
# ATENÇÃO: NUNCA comite chaves reais ou credenciais de produção (Decisões D07/D14)
# =============================================================================

# Ambiente (Testing | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development
TOPICLOG_ENV_MODE=Testing

# Banco de Dados Local Nativo (Windows 11 — PostgreSQL + PostGIS, Sem Docker)
TOPICLOG_DB_HOST=localhost
TOPICLOG_DB_PORT=5432
TOPICLOG_DB_NAME=topiclog_dev
TOPICLOG_DB_USER=postgres
TOPICLOG_DB_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY

# Storage Privado Local (Substitui S3/MinIO no ambiente de 8 GB RAM)
TOPICLOG_STORAGE_PROVIDER=LocalDisk
TOPICLOG_STORAGE_LOCAL_PATH=./storage-private

# Feature Flags Vinculantes (v2.0)
FeatureFlags__RealPaymentsEnabled=false
FeatureFlags__AsaasSandboxEnabled=true
FeatureFlags__BilateralKycRequiredOnContract=true
FeatureFlags__InsuranceCommercializationEnabled=false
FeatureFlags__RequireCodeAndPhotoForDelivery=true
FeatureFlags__RunWorkerInProcess=true

# Gateway Prioritário (Asaas Sandbox — D07)
Asaas__Environment=Sandbox
Asaas__BaseUrl=https://sandbox.asaas.com/api/v3
Asaas__ApiKey=SANDBOX_KEY_NOT_CONFIGURED
Asaas__WebhookToken=SANDBOX_WEBHOOK_TOKEN_NOT_CONFIGURED

# Frontend Next.js
NEXT_PUBLIC_APP_NAME="Topic Log"
NEXT_PUBLIC_ENVIRONMENT_MODE="Testing"
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
