# ============================================================================
# TOPICLOG — Configurações de Ambiente (apps/web)
# ============================================================================

# Integração Asaas (Produção / Sandbox)
ASAAS_ENVIRONMENT=production
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=

# URL Base da Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Em produção na Vercel:
# NEXT_PUBLIC_APP_URL=https://www.topiclog.com.br

# Provedor de E-mail Transacional — Mailbux (SMTP Seguro)
SMTP_HOST=my.mailbux.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=topiclog@topiclog.com.br
SMTP_PASS=
SMTP_FROM="Topiclog <topiclog@topiclog.com.br>"

# Blindagem de Endpoint de Diagnóstico (Obrigatório em Produção)
HEALTH_CHECK_TOKEN=""

# Deskcomm CRM — Suporte Operacional Interno (IA & Transbordo Humano)
DESKCOMM_CRM_URL=http://45.180.218.247:3300
TOPICLOG_CHAT_SECRET=fa7098440d2054dd66009e79e259daebc11a5e0ea28deba963e9435cdf9c1270

# Banco de Dados SQL Topiclog (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/topiclog"
TOPICLOG_DB_HOST="localhost"
TOPICLOG_DB_PORT="5432"
TOPICLOG_DB_NAME="topiclog"
TOPICLOG_DB_USER="postgres"
TOPICLOG_DB_PASSWORD=""
