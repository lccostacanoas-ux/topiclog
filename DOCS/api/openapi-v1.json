{
  "openapi": "3.1.0",
  "info": {
    "title": "Topic Log API — Monólito Modular",
    "version": "1.1.0-pr01.1",
    "description": "API REST da plataforma Topic Log (Minas Gerais — Piloto João Monlevade e Belo Horizonte). Ambiente de Testes / Sandbox."
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness probe e uso de memória",
        "responses": {
          "200": {
            "description": "API viva"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness probe, provedores sandbox e estado do worker",
        "responses": {
          "200": {
            "description": "API pronta"
          }
        }
      }
    },
    "/api/v1/system/feature-flags": {
      "get": {
        "summary": "Retorna feature flags e regras vinculantes v2.0 (D01-D17)",
        "responses": {
          "200": {
            "description": "Configurações ativas"
          }
        }
      }
    },
    "/api/v1/system/modules": {
      "get": {
        "summary": "Lista os 19 módulos do monólito modular",
        "responses": {
          "200": {
            "description": "Lista de módulos"
          }
        }
      }
    },
    "/api/v1/system/validate-weight": {
      "post": {
        "summary": "Valida peso em gramas por modal (5kg bicicleta, 20kg moto/carro)",
        "responses": {
          "200": {
            "description": "Peso válido"
          },
          "422": {
            "description": "ProblemDetails — Peso excedido"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Cadastro de conta multipapel sem exigência imediata de KYC (D05) e aceite de termos (D08)",
        "responses": {
          "201": {
            "description": "Conta criada"
          },
          "400": {
            "description": "ProblemDetails — Regra violada"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Autenticação com PBKDF2-HMAC-SHA256 e proteção contra força bruta",
        "responses": {
          "200": {
            "description": "Sessão iniciada"
          },
          "401": {
            "description": "Credenciais inválidas"
          },
          "423": {
            "description": "Conta temporariamente bloqueada"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Rotação de Refresh Token com detecção de reuso",
        "responses": {
          "200": {
            "description": "Sessão renovada"
          },
          "401": {
            "description": "Token inválido ou reutilizado"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Revogação da sessão atual",
        "responses": {
          "204": {
            "description": "Sessão encerrada"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Perfil privado do próprio usuário autenticado"
      },
      "patch": {
        "summary": "Atualização do próprio perfil e papéis SENDER/CARRIER/RECIPIENT"
      }
    },
    "/api/v1/users/{userId}/private-profile": {
      "get": {
        "summary": "Perfil privado protegido por ABAC (403 em acesso cruzado)"
      },
      "patch": {
        "summary": "Edição protegida por ABAC (403 em acesso cruzado)"
      }
    },
    "/api/v1/users/{userId}/public-card": {
      "get": {
        "summary": "Cartão público mínimo para contraparte sem exposição de PII (LGPD)"
      }
    },
    "/api/v1/audit/events": {
      "get": {
        "summary": "Trilha de auditoria protegida por RBAC (exclusivo SUPPORT / GENERAL_ADMIN)"
      }
    }
  }
}
